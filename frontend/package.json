{
  "name": "mininex-ui",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "native:android:init": "npm run build && npx cap add android",
    "native:ios:init": "npm run build && npx cap add ios",
    "native:android:sync": "npm run build && npx cap sync android",
    "native:ios:sync": "npm run build && npx cap sync ios",
    "native:doctor": "npx cap doctor"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "vite": "^6.1.0",
    "@capacitor/cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
